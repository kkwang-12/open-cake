:host{display:block;width:340rpx;height:280rpx;flex-shrink:0}.cake-art{position:relative;width:340rpx;height:280rpx}.shadow{position:absolute;width:304rpx;height:56rpx;left:18rpx;bottom:12rpx;border-radius:50%;background:#ab887825}.plate{position:absolute;width:336rpx;height:75rpx;left:2rpx;bottom:22rpx;border-radius:50%;background:#fffbf3;border-bottom:8rpx solid #ddd0be;box-shadow:0 12rpx 24rpx #b2987722}.body{position:absolute;width:248rpx;height:126rpx;bottom:50rpx;left:46rpx;border-radius:0 0 50% 50%;background:linear-gradient(90deg,#ead2bb,#fcebdc 28%,#fcebdc 62%,#ead2bb)}.top{position:absolute;left:46rpx;bottom:134rpx;width:248rpx;height:80rpx;background:#fffaf3;border-radius:50%;box-shadow:0 9rpx 0 #fffaf3,0 14rpx 0 #e4c6b522}.cream{position:absolute;width:31rpx;height:26rpx;border-radius:60% 60% 40% 40%;background:#fffaf3}.d1{left:56rpx;bottom:157rpx}.d2{left:94rpx;bottom:137rpx}.d3{left:140rpx;bottom:130rpx}.d4{left:187rpx;bottom:134rpx}.d5{left:233rpx;bottom:146rpx}.d6{left:254rpx;bottom:163rpx}.fruit{position:absolute;width:39rpx;height:46rpx;background:#bc574d;border-radius:45% 45% 50% 50%;box-shadow:inset -6rpx -5rpx 0 #0000000b,3rpx 5rpx 6rpx #6e3b3222;transform:rotate(12deg)}.leaf{position:absolute;left:12rpx;top:-6rpx;width:19rpx;height:11rpx;background:#768965;border-radius:80% 10% 80% 10%;transform:rotate(-30deg)}.f1{left:99rpx;bottom:173rpx;transform:rotate(-12deg)}.f2{left:159rpx;bottom:192rpx}.f3{left:206rpx;bottom:168rpx;transform:rotate(25deg)}.cocoa .body{background:linear-gradient(90deg,#5e412e,#79533c 28%,#79533c 62%,#5e412e)}.cocoa .top,.cocoa .cream{background:#563a2a}.cocoa .top{box-shadow:0 9rpx 0 #563a2a}.cocoa .fruit{background:#482b22;border-radius:3rpx;width:42rpx;height:37rpx;transform:rotate(-20deg)}.cocoa .leaf{background:#af8c66}.peach .body{background:linear-gradient(90deg,#e8bca1,#f6dccd 28%,#f6dccd 62%,#e8bca1)}.peach .top,.peach .cream{background:#fff1e7}.peach .top{box-shadow:0 9rpx 0 #fff1e7}.peach .fruit{background:#e99c