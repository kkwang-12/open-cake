@import "../../styles/action-capsule.wxss";
page { background: var(--color-bg); }
.detail-screen { padding-bottom: calc(124px + env(safe-area-inset-bottom)); background: var(--color-bg); }
.detail-screen.sheet-visible { position: fixed; left: 0; right: 0; }
.detail-nav { position: absolute; left: 6vw; z-index: 5; display: flex; align-items: center; justify-content: space-between; }
.icon-button { display: flex; align-items: center; justify-content: center; width: 44px !important; height: 44px; padding: 10px; border-radius: 50%; }
.back-button { margin-left: -10px; }
.heart-button, .heart-button[disabled] { flex-shrink: 0; background: transparent; border: 0; box-shadow: none; opacity: 1; overflow: visible; }
.heart-button::after { border: 0; box-shadow: none; }
.favorite-heart { position: relative; width: 24px; height: 24px; flex-shrink: 0; transform-origin: center; }
.favorite-icon { position: absolute; inset: 0; width: 24px; height: 24px; transition: opacity 150ms ease-out; }
.favorite-outline { opacity: 1; }
.favorite-filled { opacity: 0; }
.is-favorited .favorite-icon { transition-duration: 280ms; }
.is-favorited .favorite-outline { opacity: 0; }
.is-favorited .favorite-filled { opacity: 1; }
.heart-pop-a { animation: favorite-pop-a 280ms ease-out; }
.heart-pop-b { animation: favorite-pop-b 280ms ease-out; }
@keyframes favorite-pop-a { 0%, 100% { transform: scale(1); } 22% { transform: scale(.9); } 58% { transform: scale(1.15); } }
@keyframes favorite-pop-b { 0%, 100% { transform: scale(1); } 22% { transform: scale(.9); } 58% { transform: scale(1.15); } }
.nav-icon { width: 24px; height: 24px; }
.hero { position: relative; width: 100%; background: var(--color-bg); }
.hero-swiper, .hero-image { display: block; width: 100%; height: 100%; }
.hero-placeholder { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #9A9995; font-size: 14px; background: linear-gradient(180deg,var(--color-bg),#F1F0ED 65%,var(--color-bg)); }
.placeholder-icon { width: 64px; height: 64px; margin-bottom: 16px; opacity: .16; }
.gallery-meta { position: absolute; bottom: 10px; left: 6vw; right: 6vw; display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: #222; }
.gallery-dots { display: flex; gap: 7px; }
.dot { width: 7px; height: 7px; background: #D1D0CC; border-radius: 50%; }
.dot.active { background: #111; }
.product-content { padding: 20px 6vw 24px; }
.product-category { display: block; color: #858585; font-size: 12px; letter-spacing: 1.4px; }
.product-heading { display: flex; align-items: center; gap: 12px; margin-top: 8px; }
.product-name { flex: 1; min-width: 0; font-size: 28px; font-weight: 700; line-height: 1.3; }
.product-price { margin-top: 16px; font-size: 27px; font-weight: 650; line-height: 1.25; }
.product-description { display: block; margin-top: 14px; color: #888; font-size: 14px; line-height: 1.85; }
.benefits { display: flex; gap: 10px; margin-top: 27px; padding-top: 18px; border-top: 1px solid #EFEEEB; }
.benefit { display: flex; align-items: flex-start; gap: 7px; flex: 1; min-width: 0; }
.benefit-icon { width: 24px; height: 24px; flex-shrink: 0; }
.benefit-title { display: block; font-size: 12px; font-weight: 600; white-space: nowrap; }
.benefit-description { display: block; font-size: 10px; color: #999; margin-top: 3px; line-height: 1.5; }
.bottom-area { position: fixed; left: 0; right: 0; bottom: 0; z-index: 6; }
.add-button { display: flex; align-items: center; justify-content: center; background: #111; color: #fff; height: 58px; border-radius: 32px; font-size: 15px; font-weight: 500; }
.loading-state { text-align: center; color: #888; font-size: 14px; }
.error-state { padding: 24px 6vw; }
.modal-layer { position: fixed; inset: 0; z-index: 30; }
.sheet-mask { position: absolute; inset: 0; background: #000; opacity: 0; }
.spec-sheet { position: absolute; left: 0; right: 0; bottom: 0; max-height: 85vh; display: flex; flex-direction: column; border-radius: 28px 28px 0 0; background: var(--color-bg); overflow: hidden; transform: translateY(100%); }
.sheet-header, .sheet-footer { flex-shrink: 0; }
.sheet-closing .spec-sheet { pointer-events: none; }
.sheet-grip-area { display: flex; align-items: center; justify-content: center; width: 100% !important; height: 28px; min-height: 28px; }
.sheet-grip { width: 48px; height: 4px; background: #C6C5C1; border-radius: 4px; }
.sheet-title { padding: 3px 6vw 16px; font-size: 21px; font-weight: 700; }
.sheet-scroll { flex-shrink: 1; min-height: 0; }
.sheet-content { padding: 4px 6vw 12px; }
.option-section { margin-bottom: 24px; }
.option-heading { font-size: 14px; font-weight: 600; margin-bottom: 12px; }
.options { display: flex; flex-wrap: wrap; gap: 10px; }
.option-card { position: relative; width: auto !important; min-width: 72px; flex: 1; padding: 11px 12px; border: 1px solid transparent; background: #F0EFED; border-radius: 12px; text-align: center; overflow: visible; font-size: 13px; }
.size-options { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 11px; }
.size-card { display: flex; flex-direction: column; align-items: flex-start; width: 100% !important; min-width: 0; padding: 13px 12px; min-height: 86px; text-align: left; }
.option-label { display: block; line-height: 1.4; }
.servings { font-size: 11px; color: #888; margin-top: 5px; }
.option-price { display: block; font-size: 15px; font-weight: 600; margin-top: 12px; }
.option-card.selected { border-color: #111; background: var(--color-bg); }
.option-disabled { opacity: .35; }
.selection-mark { position: absolute; width: 22px; height: 22px; border-radius: 50%; background: #111; right: -4px; top: -7px; display: flex; align-items: center; justify-content: center; }
.selection-mark image { width: 15px; height: 15px; }
.optional { font-weight: 400; }
.message-section { margin-bottom: 23px; }
.message-wrap { display: flex; align-items: center; gap: 8px; padding: 12px 14px; border: 1px solid #E9E8E5; border-radius: 12px; }
.message-input { flex: 1; min-width: 0; font-size: 13px; height: 22px; }
.message-count { font-size: 12px; color: #999; }
.quantity-row { display: flex; align-items: center; justify-content: space-between; margin-top: 20px; }
.quantity-row .option-heading { margin-bottom: 0; }
.quantity-controls { display: flex; align-items: center; gap: 14px; }
.quantity-button { display: flex; align-items: center; justify-content: center; width: 40px !important; height: 40px; border-radius: 50%; background: #F0EFED; }
.quantity-button image { width: 19px; height: 19px; }
.quantity-button[disabled] { opacity: .35; }
.quantity-value { min-width: 20px; text-align: center; font-size: 17px; font-weight: 600; }
.selection-notice { display: block; margin-top: 16px; color: #A24D39; font-size: 12px; line-height: 1.6; }
.sheet-footer { display: flex; align-items: center; gap: 20px; padding: 16px 6vw calc(22px + env(safe-area-inset-bottom)); background: var(--color-bg); }
.total-price { flex: 1; min-width: 96px; font-size: 26px; font-weight: 650; line-height: 1.2; }
.add-button { width: 60% !important; height: 56px; flex-shrink: 0; }
.add-button[disabled] { opacity: .45; background: #111; color: #fff; }
.add-button.add-press, .add-button.add-press[disabled] { opacity: 1; animation: add-press 180ms ease-in-out both; }
@keyframes add-press { 0%, 100% { transform: scale(1); } 45% { transform: scale(.96); } }
.success-bar { display: flex; align-items: center; gap: 12px; margin: -3px -2vw -6px; padding: 14px; border-radius: 20px; background: #111; color: #fff; }
/* Keep the safe area inside the success card, with no external bottom gap. */
.bottom-area.has-success { padding-bottom: 0; }
.has-success .success-bar { margin-bottom: 0; padding-bottom: calc(14px + env(safe-area-inset-bottom)); }
.success-thumb { display: flex; align-items: center; justify-content: center; width: 50px; height: 54px; border-radius: 9px; overflow: hidden; background: #F2F1ED; flex-shrink: 0; }
.success-thumb image { width: 100%; height: 100%; }
.success-thumb .thumb-placeholder { width: 26px; height: 26px; opacity: .45; }
.success-bar { overflow: visible; animation: success-card-in 320ms cubic-bezier(0.22, 1, 0.36, 1) both; }
.success-thumb-stage { position: relative; width: 50px; height: 54px; flex-shrink: 0; }
.success-thumb { animation: success-thumb-in 220ms 100ms ease-out both; transform-origin: center; }
.success-thumb.success-thumb-pop { animation: success-thumb-pop 220ms ease-out both; }
/* Separate viewport layer avoids card clipping; it never captures taps. */
.success-particles-overlay { position: fixed; inset: 0; z-index: 40; pointer-events: none; overflow: hidden; }
.success-burst { position: absolute; width: 0; height: 0; overflow: visible; }
.success-particle { position: absolute; left: 0; top: 0; animation: success-particle-x var(--burst-duration) var(--burst-delay) linear both; }
.success-particle-flight { width: 100%; height: 100%; animation: success-particle-y var(--burst-duration) var(--burst-delay) linear both; }
.success-candy { width: 100%; height: 100%; background: var(--particle-color); animation: success-candy-spin var(--burst-duration) var(--burst-delay) linear both; }
.candy-dot { border-radius: 50%; }
.candy-sprinkle { border-radius: 999px; }
@keyframes success-card-in { from { transform: translateY(calc(100% + 24px + env(safe-area-inset-bottom))); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
@keyframes success-thumb-in { from { opacity: 0; transform: scale(.92); } to { opacity: 1; transform: scale(1); } }
@keyframes success-thumb-pop { 0% { transform: scale(.92); } 36% { transform: scale(1.05); } 70% { transform: scale(.99); } 100% { transform: scale(1); } }
/* First fifth (~100ms) releases 76% of travel, then settles into a gentle fall. */
@keyframes success-particle-x { 0% { transform: translateX(var(--burst-x-start)); animation-timing-function: ease-out; } 20% { transform: translateX(var(--burst-x-fast)); animation-timing-function: ease-out; } 60% { transform: translateX(var(--burst-x-slow)); animation-timing-function: ease-out; } 100% { transform: translateX(var(--burst-x)); } }
@keyframes success-particle-y { 0% { transform: translate(-50%, -50%) translateY(var(--burst-y-start)); animation-timing-function: ease-out; } 20% { transform: translate(-50%, -50%) translateY(var(--burst-y-fast)); } 60% { transform: translate(-50%, -50%) translateY(var(--burst-y-slow)); } 100% { transform: translate(-50%, -50%) translateY(var(--burst-y)); } }
@keyframes success-candy-spin { 0% { transform: rotate(var(--particle-rotation)) scale(.65); opacity: 0; } 7% { opacity: .92; } 20% { transform: rotate(var(--particle-rotation)) scale(1); opacity: .92; } 60% { opacity: .55; } 100% { transform: rotate(var(--particle-spin)) scale(0); opacity: 0; } }
.success-copy { flex: 1; min-width: 0; }
.success-title { display: block; font-size: 13px; font-weight: 500; }
.success-detail { display: block; font-size: 11px; color: #BBB; margin-top: 4px; line-height: 1.5; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.view-bag { display: flex; align-items: center; justify-content: center; height: 43px; width: auto !important; flex-shrink: 0; padding: 0 14px; border-radius: 24px; background: #fff; color: #111; font-size: 12px; font-weight: 600; }

.icon-button { margin: 0 !important; }
.back-button { margin-left: -10px !important; }
.quantity-button, .option-card, .view-bag, .add-button { margin: 0 !important; }
