<page-header back="{{true}}" />
<view class="page address-page">
  <view class="display-title">{{editing ? (editId ? '编辑地址' : '新增地址') : (selectMode ? '选择配送地址' : '配送地址')}}</view>
  <view class="address-note">{{scope === 'CLOUD_OWNER' ? '地址已保存至本人云账户，配送范围及位置尚待核验。' : scope === 'LOCAL_DEVICE' ? '地址仅保存在本机，配送范围及位置尚待核验。' : '地址云服务暂未开通。'}}</view>
  <view wx:if="{{error}}" class="error-note">{{error}}<button wx:if="{{!editing}}" class="secondary-action" bindtap="load">重新读取</button></view>
  <view wx:if="{{editing}}" class="address-form">
    <label class="field-label">收件人<input class="address-input" data-field="receiverName" value="{{form.receiverName}}" placeholder="收件人姓名" maxlength="2048" disabled="{{busy || saveUncertain}}" bindinput="input" /></label>
    <label class="field-label">手机号<input class="address-input" data-field="phone" value="{{form.phone}}" placeholder="11 位中国大陆手机号" type="number" maxlength="11" disabled="{{busy || saveUncertain}}" bindinput="input" /></label>
    <view class="region-fields">
      <label class="field-label">省<input class="address-input" data-field="province" value="{{form.province}}" placeholder="例如：安徽省" disabled="{{busy || saveUncertain}}" bindinput="input" /></label>
      <label class="field-label">市<input class="address-input" data-field="city" value="{{form.city}}" placeholder="例如：合肥市" disabled="{{busy || saveUncertain}}" bindinput="input" /></label>
      <label class="field-label">区 / 县<input class="address-input" data-field="district" value="{{form.district}}" placeholder="例如：庐江县" disabled="{{busy || saveUncertain}}" bindinput="input" /></label>
    </view>
    <label class="field-label">详细地址<textarea class="address-detail" data-field="detail" value="{{form.detail}}" placeholder="街道、门牌号等" maxlength="2048" disabled="{{busy || saveUncertain}}" bindinput="input" auto-height="{{true}}" /></label>
    <view wx:if="{{locationVerificationAvailable}}" class="location-verification">
      <view class="location-heading">核验地址位置</view>
      <text class="location-hint">核验后请确认地图位置，再保存地址。</text>
      <button class="secondary-action location-resolve" disabled="{{busy || locating || saveUncertain}}" bindtap="resolveLocation">{{locating ? '正在核验…' : locationCandidate ? '重新核验位置' : '核验位置'}}</button>
      <view wx:if="{{locationCandidate}}" class="location-preview">
        <map id="address-location-preview" class="location-map" latitude="{{locationCandidate.latitude}}" longitude="{{locationCandidate.longitude}}" circles="{{locationCircles}}" scale="{{17}}" show-location="{{false}}" enable-scroll="{{true}}" enable-zoom="{{true}}" enable-rotate="{{false}}" data-request="{{locationRequest}}" binderror="locationMapError" />
        <text class="location-address">{{locationCandidate.address}}</text>
        <view class="location-actions">
          <button class="secondary-action" disabled="{{busy || locating || saveUncertain || locationConfirmed}}" bindtap="confirmLocation">{{locationConfirmed ? '已确认此位置' : '确认此位置'}}</button>
          <button class="secondary-action" disabled="{{busy || locating || saveUncertain}}" bindtap="useTextAddress">仅保存文字地址</button>
        </view>
      </view>
      <text wx:if="{{locationNotice}}" class="location-hint location-notice">{{locationNotice}}</text>
    </view>
    <view class="action-row"><button class="secondary-action" disabled="{{busy}}" bindtap="cancel">返回列表</button><button class="primary-action save-address" disabled="{{busy || locating}}" bindtap="save">{{saveUncertain ? '重试保存' : '保存地址'}}</button></view>
  </view>
  <block wx:else>
    <view wx:for="{{addresses}}" wx:key="addressId" class="address-card">
      <view class="address-person"><text>{{item.receiverName}}</text><text>{{item.phone}}</text><text wx:if="{{item.isDefault}}" class="default-tag">默认</text></view>
      <text class="address-region">{{item.province}} {{item.city}} {{item.district}}</text><text class="address-street">{{item.detail}}</text>
      <view class="address-actions">
        <button wx:if="{{!item.isDefault}}" class="default-address" disabled="{{busy}}" data-id="{{item.addressId}}" data-index="{{index}}" bindtap="setDefault">设为默认</button>
        <button class="edit-address" disabled="{{busy}}" data-id="{{item.addressId}}" data-index="{{index}}" bindtap="edit">编辑</button>
        <button class="remove-address" disabled="{{busy}}" data-id="{{item.addressId}}" data-index="{{index}}" bindtap="remove">删除</button>
        <button wx:if="{{selectMode && selectionAllowed}}" class="choose-address" disabled="{{busy}}" data-id="{{item.addressId}}" data-index="{{index}}" bindtap="choose">使用此地址</button>
      </view>
    </view>
    <view wx:if="{{!addresses.length && !error && !loading}}" class="address-empty">还没有保存地址</view>
    <view wx:if="{{loading}}" class="address-empty">正在读取地址…</view>
    <button class="primary-action add-address" disabled="{{busy || loading || !scope}}" bindtap="add">新增地址</button>
  </block>
</view>
