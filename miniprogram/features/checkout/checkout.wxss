.checkout-page { padding: 32rpx 44rpx calc(180rpx + env(safe-area-inset-bottom)); }
.checkout-caption { color: #777; font-size: 24rpx; margin: 24rpx 0 32rpx; }
.checkout-line { padding: 28rpx 0; border-bottom: 1rpx solid #e5e2dd; }
.checkout-line-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 24rpx; }
.checkout-name { flex: 1; font-size: 30rpx; font-weight: 600; }
.checkout-total { font-size: 30rpx; white-space: nowrap; }
.checkout-detail, .checkout-message { display: block; font-size: 24rpx; color: #777; margin-top: 14rpx; line-height: 1.6; overflow-wrap: break-word; }
.checkout-subtotal { display: flex; justify-content: space-between; font-size: 32rpx; font-weight: 600; margin-top: 40rpx; }
.checkout-notice { color: #777; font-size: 24rpx; line-height: 1.8; margin: 32rpx 0; }
.return-bag { width: 100% !important; }
.checkout-footer { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; padding: 24rpx 44rpx calc(24rpx + env(safe-area-inset-bottom)); }
.checkout-address { margin-bottom: 20rpx; padding: 24rpx 0; border-bottom: 1rpx solid #e5e2dd; }
.address-heading { display: flex; justify-content: space-between; align-items: center; font-size: 28rpx; font-weight: 600; }
.choose-delivery-address { margin: 0; width: auto !important; font-size: 24rpx; font-weight: 400; border: 1rpx solid #d5d2cd; border-radius: 30rpx; padding: 12rpx 24rpx; }
.delivery-person, .delivery-detail, .address-hint, .address-warning { display: block; font-size: 24rpx; line-height: 1.7; margin-top: 12rpx; overflow-wrap: break-word; }
.address-hint { color: #777; font-size: 22rpx; }
.address-warning { color: #805b36; }
.checkout-store { padding: 22rpx 0 30rpx; border-bottom: 1rpx solid #e5e2dd; }
.store-name { font-size: 30rpx; font-weight: 600; }
.store-address, .store-hours, .store-phone { display: block; font-size: 24rpx; line-height: 1.7; margin-top: 12rpx; }
.store-hours, .store-phone { color: #777; }
.fulfillment-options { display: flex; gap: 18rpx; margin: 30rpx 0; }
.fulfillment-option { flex: 1; width: auto !important; margin: 0; border: 1rpx solid #d5d2cd; border-radius: 40rpx; padding: 22rpx 12rpx; font-size: 26rpx; }
.fulfillment-option.is-active { color: #fff; background: #111; border-color: #111; }
.fulfillment-option[disabled] { opacity: .4; }
.pickup-form { padding: 12rpx 0 28rpx; border-bottom: 1rpx solid #e5e2dd; }
.pickup-label { display: block; font-size: 24rpx; margin-top: 24rpx; }
.pickup-input { display: block; width: 100%; height: 90rpx; font-size: 28rpx; background: #f1efec; border-radius: 16rpx; padding: 24rpx; margin-top: 12rpx; }
.contact-save-row { display: flex; gap: 18rpx; align-items: center; justify-content: space-between; margin-top: 24rpx; }
.contact-save-row text { color: #777; font-size: 22rpx; flex: 1; }
.save-pickup-contact { width: auto !important; margin: 0; padding: 16rpx 24rpx; border-radius: 32rpx; background: #111; color: #fff; font-size: 24rpx; }
.fulfillment-fee { display: flex; justify-content: space-between; font-size: 26rpx; margin-top: 20rpx; color: #777; }
.delivery-range-status { padding: 20rpx 24rpx; margin-top: 20rpx; background: #f1efec; border-radius: 16rpx; }
.delivery-range-label { display: block; font-size: 24rpx; font-weight: 600; }
