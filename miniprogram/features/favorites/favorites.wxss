.remove-favorite { min-height:44px;color:var(--color-muted);font-size:24rpx; }
.page { padding-left: 16px; padding-right: 16px; }
.page .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.unavailable-card { min-height:300rpx;padding:24rpx;background:var(--color-surface);border-radius:20rpx; }
.unavailable-card .name { display:block;font-weight:600;margin-bottom:16rpx; }
