@import "../../styles/action-capsule.wxss";
.bag-page { padding-top: 4px; padding-bottom: 256px; }
.bag-page .display-title { margin: 0 0 6px; font-size: 32px; font-weight: 700; line-height: 1.3; }
.bag-count { color: #777; font-size: 14px; line-height: 1.5; margin-bottom: 24px; }
.bag-line { display: flex; align-items: stretch; gap: 16px; margin-bottom: 10px; padding-bottom: 8px; border-bottom: 1px solid #E9E7E3; }
.line-thumbnail { position: relative; align-self: flex-start; flex: 0 0 112px; width: 112px; height: 128px; border-radius: 12px; overflow: hidden; background: #F0EFED; }
.line-image { position: absolute; top: 0; left: 0; display: block; width: 100%; height: 100%; }
.line-image-placeholder { position: absolute; top: 0; left: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; width: 100%; height: 100%; color: #999; font-size: 10px; }
.line-image-placeholder image { width: 28px; height: 28px; opacity: .3; }
.line-heading { display: flex; align-items: flex-start; gap: 8px; }
.line-name { flex: 1; min-width: 0; font-size: 16px; font-weight: 600; line-height: 1.45; overflow-wrap: anywhere; word-break: break-word; }
.line-unit-price { flex-shrink: 0; color: #111; font-size: 16px; font-weight: 600; line-height: 1.45; white-space: nowrap; }
.line-spec { display: block; margin-top: 4px; color: #777; font-size: 13px; line-height: 1.5; overflow-wrap: anywhere; word-break: break-word; }
.line-content { display: flex; flex-direction: column; flex: 1; width: 0; min-width: 0; }
.bag-line-bottom { display: flex; width: 100%; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 8px; padding-top: 8px; margin-top: auto; }
.bag-message { display: block; color: #777; font-size: 13px; line-height: 1.5; margin-top: 4px; overflow-wrap: anywhere; word-break: break-word; }
.bag-storage-note { padding: 0 0 12px; color: #888; font-size: 11px; line-height: 1.5; }
.review-notice { margin-top: 18rpx; color: #805b36; font-size: 24rpx; line-height: 1.6; }
.review-notice text { display: block; }
.accept-changes, .review-retry { width: auto !important; margin: 16rpx 0 0; padding: 10rpx 22rpx; display: inline-block; background: #f0eeeb; color: #111; font-size: 24rpx; border-radius: 30rpx; }
.accept-changes::after, .review-retry::after { border: 0; }
.line-excluded { display: block; color: #805b36; font-size: 22rpx; margin-top: 8rpx; }
.remove-line { flex: 0 0 44px; width: 44px !important; height: 44px; padding: 0; margin-top: 0; margin-bottom: 0; margin-left: auto !important; margin-right: -11px !important; display: flex; align-items: center; justify-content: center; background: transparent; }
.remove-line::after { border: 0; }
.remove-line image { display: block; width: 22px; height: 22px; }
.remove-line[disabled] { opacity: .4; background: transparent; }
.quantity-control { display: flex; flex-shrink: 0; align-items: center; gap: 12px; padding: 2px; border: 0; border-radius: 999px; background: #F3F2F0; color: #000; font-size: 15px; font-weight: 600; line-height: 1.5; }
.quantity-control text { min-width: 24px; text-align: center; }
.quantity-control button { flex: 0 0 32px; width: 32px !important; height: 32px; border-radius: 50%; background: #EAE9E7 !important; margin: 0 !important; padding: 0; display: flex; align-items: center; justify-content: center; }
.quantity-control button::after { border: 0; }
.quantity-control button[disabled] { opacity: .4; }
.quantity-control image { width: 16px; height: 16px; }
.bag-summary { position: fixed; z-index: 20; bottom: 0; left: 0; right: 0; box-shadow: 0 -1rpx 0 #eee; }
.summary-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; color: #666; font-size: 14px; line-height: 1.6; margin-bottom: 4px; }
.summary-note { display: block; color: #888; font-size: 11px; line-height: 1.5; }
.summary-total { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 10px 0; color: #111; font-size: 20px; font-weight: 600; }
.summary-amount { font-size: 28px; font-weight: 700; }
.checkout-button[disabled] { opacity: .4; background: #111 !important; color: #fff !important; }
