<page-header title="" />
<view class="page bag-page" style="padding-bottom: {{lines.length ? summaryHeight + 16 : 24}}px;"><view class="display-title">购物袋</view>
  <view class="bag-count">共 {{quantity}} 件商品</view>
  <view wx:if="{{error}}" class="error-note">{{error}}<button class="secondary-action" bindtap="load">重试</button></view>
  <view wx:if="{{loading}}" class="status-note">正在核验商品信息…</view>
  <block wx:if="{{lines.length}}">
    <view wx:for="{{lines}}" wx:key="lineId" class="bag-line">
      <view class="line-thumbnail" bindtap="openProduct" data-id="{{item.productId}}" aria-label="查看{{item.name}}">
        <image wx:if="{{(item.image || thumbnails[item.productId]) && imageFailures[item.productId] !== (item.image || thumbnails[item.productId])}}" class="line-image" src="{{item.image || thumbnails[item.productId]}}" mode="aspectFill" data-id="{{item.productId}}" data-src="{{item.image || thumbnails[item.productId]}}" binderror="thumbnailError" />
        <view wx:else class="line-image-placeholder"><image src="/assets/icons/cake-ui/cake-slice.svg" /><text>暂无图片</text></view>
      </view>
      <view class="line-content"><view bindtap="openProduct" data-id="{{item.productId}}">
        <view class="line-heading"><view class="line-name">{{item.name}}</view><view class="line-unit-price" aria-label="单价 {{item.priceLabel}} 元">¥ {{item.priceLabel}}</view></view>
        <text class="line-spec">{{item.specLabel}}</text><text wx:if="{{item.cakeMessage}}" class="bag-message">{{item.cakeMessage}}</text></view>
        <view wx:if="{{item.reviewNotice}}" class="review-notice">{{item.reviewNotice}}<text wx:if="{{item.reviewStatus === 'PRICE_CHANGED'}}">原单价 ¥{{item.priceLabel}} → 当前 ¥{{item.currentPriceLabel}}</text><text wx:if="{{item.reviewStatus === 'CONFIG_CHANGED'}}">当前：{{item.currentName}} · {{item.currentSpecLabel}}</text></view>
        <button wx:if="{{item.canAcceptChanges}}" class="accept-changes" disabled="{{busy || loading}}" data-id="{{item.lineId}}" data-index="{{index}}" bindtap="acceptChanges">确认更新</button>
        <button wx:if="{{item.reviewStatus === 'REVIEW_FAILED'}}" class="review-retry" disabled="{{busy || loading}}" bindtap="load">重新核验</button>
        <text wx:if="{{!item.canSelect}}" class="line-excluded">此商品暂不计入结算金额</text>
        <view class="bag-line-bottom"><view class="quantity-control">
          <button class="quantity-minus" data-id="{{item.lineId}}" data-index="{{index}}" data-delta="-1" bindtap="changeQuantity" disabled="{{busy || loading || !item.canAdjust || item.quantity === 1}}" aria-label="减少数量"><image src="/assets/icons/cake-ui/bag-minus.svg" /></button><text>{{item.quantity}}</text>
          <button class="quantity-plus" data-id="{{item.lineId}}" data-index="{{index}}" data-delta="1" bindtap="changeQuantity" disabled="{{busy || loading || !item.canAdjust}}" aria-label="增加数量"><image src="/assets/icons/cake-ui/bag-plus.svg" /></button>
        </view><button class="remove-line" disabled="{{busy || loading}}" data-id="{{item.lineId}}" data-index="{{index}}" bindtap="remove" aria-label="移除{{item.name}}，{{item.specLabel}}"><image src="/assets/icons/cake-ui/trash.svg" mode="aspectFit" /></button></view>
      </view>
    </view>
    <view class="bag-storage-note">已保存在本机。商品、库存及履约信息核验后才能结算。</view>
  </block>
  <empty-state wx:elif="{{!error && !loading}}" title="购物袋为空" description="选一份心意，放进购物袋。" action="浏览商品" bind:action="goShop" />
</view>
<view wx:if="{{lines.length}}" class="bag-summary action-safe-footer">
  <view class="summary-row"><text>商品金额</text><text>¥ {{subtotalLabel}}</text></view>
  <view class="summary-row"><text>预计配送费</text><text>待确认</text></view>
  <text class="summary-note">配送费将在确认履约信息后核验，暂未计入合计。</text>
  <text wx:if="{{excludedQuantity}}" class="summary-note">{{excludedQuantity}} 件商品暂不可结算，请查看对应商品提示。</text>
  <view class="summary-total"><text>合计</text><text class="summary-amount">¥ {{subtotalLabel}}</text></view>
  <button class="checkout-button action-capsule" disabled="{{busy || loading || !selectedQuantity}}" bindtap="previewSelected">去结算（{{quantity}}）</button>
</view>
