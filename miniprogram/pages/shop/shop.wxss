.shop-header { background: var(--color-bg); }
.shop-header-inner { display: flex; align-items: center; gap: 8px; padding-left: 16px; }
.shop-brand { flex: 1; min-width: 0; color: #111111; font-size: 22px; font-weight: 600; line-height: 1.25; white-space: nowrap; }
.shop-bag { position: relative; flex: 0 0 44px; display: flex; align-items: center; justify-content: center; width: 44px !important; height: 44px; margin: 0 !important; padding: 0; background: transparent; }
.shop-bag image { display: block; width: 40rpx; height: 40rpx; }
.shop-title { display: block; margin: 0; color: #111111; font-size: 26px; font-weight: 600; line-height: 1.3; }
.category-segments { width: 100%; margin: 12px 0 16px; padding: 2px; border-radius: 999rpx; background: #EFEFED; }
.category-track { position: relative; display: flex; width: 100%; }
/* Keep this single slider mounted: interrupted transitions continue from the current rendered position. */
.category-slider { position: absolute; left: 0; top: 0; width: 33.333333%; height: 100%; border-radius: 999rpx; background: #111111; pointer-events: none; transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1); }
.category-segment { position: relative; z-index: 1; flex: 1 1 0; display: flex; align-items: center; justify-content: center; width: 33.333333% !important; min-width: 0; min-height: 40px; margin: 0 !important; padding: 0 8rpx; border: 0; border-radius: 999rpx; background: transparent; color: #666666; font-size: 14px; font-weight: 400; line-height: 1.4; white-space: nowrap; transition: color 350ms cubic-bezier(0.22, 1, 0.36, 1); }
.category-segment::after { border: 0; }
.category-segment.category-active { color: #FFFFFF; font-weight: 500; }

.list-feedback { display: flex; flex-direction: column; align-items: center; gap: 24rpx; margin-top: 40rpx; color: #666666; font-size: 24rpx; }
.list-feedback .secondary-action { min-width: 240rpx; }
/* Match the confirmed two-column card geometry and spacing. */
.page { padding-top: 12px; padding-right: 16px; padding-left: 16px; padding-bottom: calc(124px + env(safe-area-inset-bottom)); }
.page .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
