.category-scroll { margin: 32rpx 0; width: 100%; white-space: nowrap; }
.categories { display: inline-flex; gap: 32rpx; min-width: 100%; border-bottom: 1rpx solid #E5E2DD; }
.category { width: auto !important; min-height: 44px; flex-shrink: 0; padding: 16rpx 0 24rpx; border-bottom: 4rpx solid transparent; color: #666666; font-size: 28rpx; }
.category-en { display: block; font-size: 22rpx; margin-top: 8rpx; }
.selected { border-bottom-color: #111111; color: #111111; }
