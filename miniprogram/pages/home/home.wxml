<view class="tab-content {{tabMotion}}">
<view class="page home">
  <view class="home-first-screen">
    <view class="home-hero">
      <swiper class="home-hero-swiper" current="{{heroCurrent}}" autoplay="{{false}}" circular="{{false}}" indicator-dots="{{false}}" vertical="{{false}}" duration="{{300}}" easing-function="easeOutCubic" bindchange="heroChange" bindtouchstart="heroTouchStart" bindtouchmove="heroTouchMove" bindtouchend="heroTouchEnd" bindtouchcancel="heroTouchCancel" aria-label="蛋糕推荐轮播">
        <swiper-item wx:for="{{heroSlides}}" wx:key="id">
          <view class="home-hero-slide">
            <view class="home-hero-photography">
              <view wx:if="{{!item.imageReady || item.imageFailed}}" class="home-hero-image-fallback"><image src="/assets/icons/product/cake-slice.svg" /><text>{{item.imageFailed ? '商品照片正在准备' : '照片加载中'}}</text></view>
              <image wx:if="{{!item.imageFailed && (item.imageReady || index >= heroCurrent - 1 && index <= heroCurrent + 1)}}" class="home-hero-image {{item.imageReady ? '' : 'home-hero-image-loading'}}" src="{{item.image}}" mode="aspectFill" lazy-load="{{false}}" data-index="{{index}}" bindload="heroImageLoad" binderror="heroImageError" aria-label="{{item.imageLabel}}" />
            </view>
            <view class="home-hero-copy">
              <view class="home-hero-title"><text wx:for="{{item.titleLines}}" wx:for-item="line" wx:for-index="lineIndex" wx:key="*this">{{line}}</text></view>
              <text class="home-hero-subtitle">{{item.subtitle}}</text>
              <button class="home-explore" data-index="{{index}}" bindtap="heroAction" hover-class="pressed">{{item.buttonText}}<text class="home-cta-arrow">→</text></button>
            </view>
          </view>
        </swiper-item>
      </swiper>
      <view class="home-hero-gradient" />
      <view wx:if="{{heroSlides.length > 1}}" class="home-hero-indicators" aria-label="第 {{heroCurrent + 1}} 张，共 {{heroSlides.length}} 张"><view wx:for="{{heroSlides}}" wx:key="id" class="home-hero-dot {{index === heroCurrent ? 'home-hero-dot-active' : ''}}" /></view>
    </view>
  <view class="section home-recommendations">
    <view class="section-heading"><text class="section-title">今日推荐</text><button class="home-view-all" bindtap="browse" hover-class="pressed">查看全部<text>→</text></button></view>
    <view wx:if="{{products.length}}" class="product-grid"><product-card wx:for="{{products}}" wx:if="{{index < 2}}" wx:key="id" product="{{item}}" bind:select="select" /></view>
    <empty-state wx:elif="{{loading}}" loading="{{true}}" description="正在准备商品。" />
    <empty-state wx:elif="{{error}}" title="暂时无法加载" description="{{error}}" action="重新加载" bind:action="retry" />
    <empty-state wx:else title="新鲜好物即将上架" description="期待与你分享每一份新鲜。" action="浏览选购" bind:action="browse" />
  </view>
  </view>
  <view wx:if="{{products.length > 2}}" class="home-more-recommendations product-grid"><product-card wx:for="{{products}}" wx:if="{{index >= 2}}" wx:key="id" product="{{item}}" bind:select="select" /></view>
  <text wx:if="{{products.length && !recommendationConfigured}}" class="footnote">当前展示分类商品，门店推荐待配置。</text>
  <text wx:if="{{source === 'DEVELOPMENT_EXAMPLE'}}" class="footnote">临时开发商品与价格 · 商品照片待补充 · 暂未开放购买</text>
</view>

</view>
