/* UI-R01A: local Home tokens; shared tokens and lower product cards stay unchanged. */
.home-header, .home {
  --home-space-4: 8rpx;
  --home-space-8: 16rpx;
  --home-space-12: 24rpx;
  --home-space-16: 32rpx;
  --home-space-24: 48rpx;
  --home-space-32: 64rpx;
  --home-inset: var(--home-space-16);
}
.home-header { background: var(--color-bg); }
.home-header-inner { display: flex; align-items: center; gap: var(--home-space-8); padding-left: var(--home-inset); }
.home-brand { flex: 1; min-width: 0; }
.home-brand-name { display: block; color: var(--color-text); font-size: 36rpx; font-weight: 600; line-height: 1.25; }
.home-brand-descriptor { display: block; margin-top: var(--home-space-4); color: var(--color-body); font-size: 18rpx; font-weight: 400; line-height: 1.4; letter-spacing: 2px; }
.home-bag { flex: 0 0 44px; display: flex; align-items: center; justify-content: center; width: 44px !important; height: 44px; margin: 0; padding: 0; background: transparent; }
.home-bag image { display: block; width: 44rpx; height: 44rpx; }
.home { padding-top: 0; padding-right: var(--home-inset); padding-left: var(--home-inset); }
.home-hero { position: relative; height: 600rpx; }
.home-hero-copy { position: relative; z-index: 1; padding-top: var(--home-space-24); pointer-events: none; }
.home-hero-eyebrow { display: block; color: var(--color-body); font-size: 20rpx; font-weight: 400; line-height: 1.4; letter-spacing: 2px; }
.home-hero-title { width: 464rpx; max-width: 100%; margin-top: var(--home-space-8); color: var(--color-text); font-size: 56rpx; font-weight: 650; line-height: 1.12; letter-spacing: -0.6px; }
.home-hero-subtitle { display: block; width: 236rpx; margin-top: var(--home-space-24); color: var(--color-body); font-size: 24rpx; font-weight: 400; line-height: 1.8; }
.home-subtitle-line { display: block; }
.home-explore { display: inline-flex; align-items: center; justify-content: center; gap: var(--home-space-8); width: auto !important; min-height: 44px; margin: var(--home-space-24) 0 0; padding: 0 var(--home-space-16); color: #FFFFFF; background: var(--color-text); border-radius: 999rpx; font-size: 24rpx; font-weight: 500; line-height: 44px; white-space: nowrap; pointer-events: auto; }
.home-cta-arrow { font-size: 28rpx; font-weight: 400; }
.home-hero-photography { position: absolute; top: 168rpx; right: -16rpx; width: 500rpx; height: 420rpx; pointer-events: none; }
.home-hero-image { display: block; width: 100%; height: 100%; }
.home-hero-image-fallback { display: flex; align-items: center; justify-content: center; height: 100%; color: var(--color-muted); font-size: 22rpx; }
.home-category-card { position: relative; z-index: 2; display: flex; margin-top: -24rpx; padding: var(--home-space-8); background: var(--color-surface); border: 0; border-radius: 24rpx; box-shadow: none; }
.home-category { flex: 1 1 0; display: flex; flex-direction: column; align-items: center; width: 33.333333% !important; min-width: 0; min-height: 44px; margin: 0; padding: 4rpx 0; color: #333333; background: transparent; text-align: center; line-height: 1.4; }
.home-category-thumbnail { display: flex; align-items: center; justify-content: center; width: 120rpx; height: 112rpx; overflow: hidden; border-radius: 50%; background: transparent; }
.home-category-thumbnail image { display: block; width: 100%; height: 100%; transform: scale(1.12); mix-blend-mode: multiply; }
.home-category-name { display: block; margin-top: var(--home-space-4); font-size: 24rpx; font-weight: 500; line-height: 1.35; }
.home-category-en { display: block; margin-top: 0; color: var(--color-muted); font-size: 18rpx; font-weight: 400; line-height: 1.4; }
.home-category-image-fallback { padding: var(--home-space-4); color: var(--color-muted); font-size: 18rpx; font-weight: 400; }
.home .section-heading .eyebrow { color: var(--color-body); font-size: 20rpx; font-weight: 400; letter-spacing: 2px; }
.home .section-heading .section-title { color: #222222; font-weight: 600; }
