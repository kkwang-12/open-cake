/* Home scene, typography and spacing remain scoped to this page. */
.home {
  --home-inset: 16px;
}
.home { padding-top: 0; padding-right: 0; padding-left: 0; padding-bottom: calc(124px + env(safe-area-inset-bottom)); background: var(--color-bg); }
/* Card padding plus 8px clearance leaves the price 16px above navigation. */
.home-first-screen { display: flex; flex-direction: column; min-height: calc(100vh - 78px - env(safe-area-inset-bottom) - 8px); }
.home-hero { position: relative; display: flex; align-items: flex-end; flex: 1; min-height: 276px; overflow: hidden; background: #EFE9DF; }
.home-hero-swiper { position: absolute; inset: 0; width: 100%; height: 100%; }
.home-hero-slide { position: relative; display: flex; align-items: flex-end; width: 100%; height: 100%; overflow: hidden; }
.home-hero-image-loading { opacity: 0; }
.home-hero-photography { position: absolute; inset: 0; pointer-events: none; }
.home-hero-image { position: absolute; bottom: -8px; left: 0; display: block; width: 100%; height: 125vw; min-height: calc(100% + 8px); }
.home-hero-image-fallback { display: flex; flex-direction: column; align-items: flex-end; justify-content: flex-end; gap: 8px; width: 100%; height: 100%; padding: 32px var(--home-inset) 48px; color: #999; font-size: 13px; }
.home-hero-image-fallback image { width: 64px; height: 64px; opacity: .3; margin-right: 20px; }
.home-hero-copy { position: relative; z-index: 2; width: 100%; padding: 28px var(--home-inset); pointer-events: none; }
.home-hero-title { margin: 0; color: var(--color-text); font-size: 30px; font-weight: 500; line-height: 1.28; }
.home-hero-title text { display: block; white-space: nowrap; }
.home-hero-subtitle { display: block; max-width: 240px; margin-top: 12px; color: #444; font-size: 14px; font-weight: 400; line-height: 1.6; }
.home-explore { display: inline-flex; align-items: center; justify-content: center; gap: 10px; width: auto !important; height: 48px; margin: 16px 0 0 !important; padding: 0 20px; color: #fff; background: #111; border-radius: 999px; font-size: 15px; font-weight: 500; line-height: 1.6; white-space: nowrap; pointer-events: auto; }
.home-cta-arrow { font-size: 20px; font-weight: 400; }
/* This stationary strip only softens the bottom table area. */
.home-hero-gradient { position: absolute; z-index: 1; left: 0; right: 0; bottom: 0; height: 12px; background: linear-gradient(180deg,rgba(250,250,248,0),var(--color-bg)); pointer-events: none; }
.home-hero-indicators { position: absolute; z-index: 3; left: var(--home-inset); bottom: 15px; display: flex; gap: 6px; pointer-events: none; }
.home-hero-dot { width: 5px; height: 5px; border-radius: 50%; background: #C9C7C2; }
.home-hero-dot-active { background: #111111; }
.home .home-recommendations { position: relative; flex-shrink: 0; margin: 0; padding: 14px 16px 0; background: var(--color-bg); border-radius: 0; box-shadow: none; }
.home .home-recommendations .section-heading { align-items: center; height: 28px; min-height: 0; margin: 0 0 10px; padding: 0; }
.home .home-recommendations .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 0; padding: 0; }
.home .home-more-recommendations { gap: 12px; margin: 12px 16px 0; padding: 0; }
.home .section-heading .section-title { display: block; color: #111; font-size: 20px; font-weight: 600; line-height: 1.4; }
.home-view-all { position: relative; overflow: visible; display: flex; align-items: center; justify-content: flex-end; gap: 10px; width: auto !important; height: 28px; min-height: 28px; margin: 0 !important; padding: 0; color: #111; background: transparent; font-size: 13px; font-weight: 400; }
.home-view-all::before { content: ''; position: absolute; left: 0; right: 0; top: -8px; bottom: -8px; }
.home-view-all text { font-size: 16px; }
.home .footnote { margin-right: var(--home-inset); margin-left: var(--home-inset); font-size: 12px; font-weight: 400; line-height: 1.5; }
@media (max-width: 350px) {
  .home-hero-title { font-size: 28px; }
  .home-hero-subtitle { max-width: 210px; font-size: 13px; }
}
