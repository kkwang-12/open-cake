<page-header back="{{true}}" bag="{{true}}" />
<view class="page">
  <block wx:if="{{product}}">
    <image wx:if="{{!imageFailed}}" class="gallery" src="{{product.image}}" mode="aspectFill" binderror="imageError" />
    <view wx:else class="gallery fallback">图片暂未加载</view>
    <view class="section"><text class="eyebrow">CAKE / BAKERY</text><view class="title">{{product.name}}</view><text class="subtitle">{{product.description}}</text><view class="title">¥{{product.priceLabel}}</view></view>
    <button class="primary-action" disabled="{{true}}">暂未开放购买</button>
    <text class="footnote">示例商品与价格 · 图片为设计预览素材</text>
  </block>
  <empty-state wx:else title="商品暂未开放" description="商品资料正在准备，欢迎浏览其他精选。" action="返回选购" bind:action="browse" />
</view>
