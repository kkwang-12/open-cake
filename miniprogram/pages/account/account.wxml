<page-header />
<view class="page">
  <text class="eyebrow">ACCOUNT</text><view class="display-title">Hello.<view>欢迎来到家家乐。</view></view>
  <button class="list-row" data-target="orders" bindtap="navigate"><text>ORDERS · 我的订单</text><text>→</text></button>
  <button class="list-row" data-target="favorites" bindtap="navigate"><text>FAVORITES · 我的收藏</text><text>→</text></button>
  <button class="list-row" data-target="addresses" bindtap="navigate"><text>ADDRESSES · 配送地址</text><text>→</text></button>
  <view class="section">
    <button class="list-row" data-target="service" bindtap="information"><text>CUSTOMER SERVICE · 联系客服</text><text>→</text></button>
    <button class="list-row" data-target="store" bindtap="information"><text>STORE · 门店信息</text><text>→</text></button>
    <button class="list-row" data-target="about" bindtap="information"><text>ABOUT · 关于品牌</text><text>→</text></button>
  </view>
  <button class="list-row" data-target="privacy" bindtap="information"><text>隐私与服务说明</text><text>→</text></button>
  <view wx:if="{{showDevelopment}}" class="section">
    <text class="eyebrow">开发验证</text>
    <button class="secondary-action" bindtap="checkCloud" loading="{{busy}}" disabled="{{busy}}">检查身份与服务连通</button>
    <view wx:if="{{error}}" class="error-note">{{error}}<text class="error-reference">{{requestId}}</text></view>
    <view wx:if="{{diagnostic}}" class="status-note">{{diagnostic}}<text class="error-reference">{{requestId}}</text></view>
    <button wx:if="{{legacyEnabled}}" class="list-row" bindtap="legacy"><text>旧预订演示 · 模拟定金与尾款</text><text>→</text></button>
  </view>
</view>
