<view class="demo">演示环境 · 支付、退款和消息均为模拟</view><view class="page"><view wx:if="{{error}}" class="error" bindtap="refresh">{{error}} · 点击刷新</view><block wx:if="{{order}}"><view class="panel status-panel"><view class="title">{{order.statusLabel}}</view><view class="small muted">{{order.number}}</view><view wx:if="{{order.request}}" class="info">售后申请待审核，暂缓订单操作。</view><view class="actions" wx:if="{{role === 'customer'}}"><button wx:if="{{order.canDeposit}}" disabled="{{busy}}" data-stage="deposit" bindtap="pay">付定金 ¥{{order.depositYuan}}</button><button wx:if="{{order.canBalance}}" disabled="{{busy}}" data-stage="balance" bindtap="pay">付尾款 ¥{{order.dueYuan}}</button><button wx:if="{{order.canRequest}}" class="outline" bindtap="request">申请取消或改期</button></view><view class="actions" wx:if="{{role === 'staff'}}"><button wx:if="{{order.canConfirm}}" disabled="{{busy}}" bindtap="confirm">确认接单</button><button wx:if="{{order.canConfirm}}" class="outline" bindtap="reject">无法接单</button><button wx:if="{{order.canMake}}" disabled="{{busy}}" data-status="MAKING" bindtap="progress">开始制作</button><button wx:if="{{order.canReady}}" disabled="{{busy}}" data-status="READY" bindtap="progress">制作完成</button><button wx:if="{{order.canDeliver}}" disabled="{{busy}}" data-status="DELIVERING" bindtap="progress">开始配送</button><button wx:if="{{order.canBalance}}" class="light" bindtap="offline">登记线下尾款</button><button wx:if="{{order.canComplete}}" disabled="{{busy}}" data-status="COMPLETED" bindtap="progress">确认交付完成</button></view></view><view class="panel"><view class="section-title">蛋糕与交付</view><view class="product-line"><view class="thumb"><cake-art theme="{{order.product.theme}}"/></view><view><view class="name">{{order.product.name}}</view><view class="small muted">{{order.product.size}} / {{order.product.flavor}}</view></view></view><view class="data-row"><text class="label">祝福语</text><text>{{order.message || '无'}}</text></view><view class="data-row"><text class="label">交付方式</text><text>{{order.fulfillment === 'pickup' ? '到店自取' : '免费配送'}}</text></view><view class="data-row"><text class="label">交付时间</text><text>{{order.date}} {{order.time}}</text></view><view class="data-row"><text class="label">联系人</text><text>{{order.contactName}} · {{order.phone}}</text></view><view class="data-row"><text class="label">地址</text><text>{{order.fulfillment === 'delivery' ? order.address : shopAddress}}</text></view><view class="data-row"><text class="label">备注</text><text>{{order.note || '无'}}</text></view></view><view wx:if="{{order.request}}" class="panel"><view class="section-title">{{order.request.type === 'cancel' ? '取消' : '改期'}}申请 · 待审核</view><view class="data-row"><text class="label">原因</text><text>{{order.request.reason}}</text></view><view wx:if="{{order.request.type === 'reschedule'}}" class="data-row"><text class="label">期望时间</text><text>{{order.request.date}} {{order.request.time}}</text></view><button wx:if="{{role === 'staff'}}" bindtap="review">审核申请</button><view wx:else class="small muted">店员审核后会更新结果，订单尚未自动取消或改期。</view></view><view class="panel"><view class="section-title">收款明细</view><view class="data-row"><text class="label">订单总额</text><text>¥{{order.totalYuan}}</text></view><view class="data-row"><text class="label">定金 30%</text><text>¥{{order.depositYuan}} · {{order.depositPaidCents ? '已付' : '待付'}}</text></view><view class="data-row"><text class="label">尾款</text><text>¥{{order.balanceYuan}} · {{order.balancePaidCents ? '已付' : '待付'}}</text></view><view class="data-row"><text class="label">已退款</text><text>¥{{order.refundedYuan}}</text></view><view wx:for="{{order.refunds}}" wx:key="id" class="info"><view>退款 ¥{{item.amountYuan}} · {{item.statusLabel}}</view><view wx:if="{{role === 'staff' && item.status !== 'SUCCEEDED'}}" class="actions"><button class="light" data-id="{{item.id}}" data-success="true" bindtap="refund">模拟退款成功</button><button class="outline" data-id="{{item.id}}" data-success="false" bindtap="refund">模拟失败</button></view></view></view><view class="panel"><view class="section-title">订单记录</view><view class="timeline"><view wx:for="{{order.history}}" wx:key="id" class="history"><view>{{item.message}}</view><text class="muted">{{item.timeLabel}}</text></view></view></view><button class="outline" disabled="{{busy}}" bindtap="refresh">刷新订单进度</button></block></view>
<view wx:if="{{sheet}}" class="sheet-backdrop"><scroll-view scroll-y class="sheet"><view class="row"><view class="section-title">{{sheet === 'request' ? '取消或改期申请' : '审核售后申请'}}</view><text bindtap="close">关闭</text></view><view wx:if="{{error}}" class="error">{{error}}</view><block wx:if="{{sheet === 'request'}}"><view class="field"><text class="field-label">申请类型</text><picker range="{{requestTypes}}" value="{{requestTypeIndex}}" data-field="requestTypeIndex" bindchange="select"><view class="picker">{{requestTypes[requestTypeIndex]}}</view></picker></view><view class="field"><text class="field-label">申请原因</text><textarea value="{{reason}}" data-field="reason" bindinput="input" maxlength="200"/></view><block wx:if="{{requestTypeIndex === 1}}"><view class="field"><text class="field-label">新的交付日期</text><picker mode="date" value="{{newDate}}" start="{{minDate}}" bindchange="date"><view class="picker">{{newDate}}</view></picker></view><view class="field"><text class="field-label">新的交付时间</text><picker mode="time" value="{{newTime}}" start="{{openTime}}" end="{{closeTime}}" bindchange="time"><view class="picker">{{newTime}}</view></picker></view></block><button disabled="{{busy}}" loading="{{busy}}" bindtap="submitRequest">提交申请</button></block><block wx:else><view class="field"><text class="field-label">审核结果</text><picker range="{{reviewOptions}}" value="{{approvedIndex}}" data-field="approvedIndex" bindchange="select"><view class="picker">{{reviewOptions[approvedIndex]}}</view></picker></view><view wx:if="{{order.request.type === 'cancel'}}" class="field"><text class="field-label">退款金额（元；线上可退 ¥{{order.onlineRefundableYuan}}）</text><input type="digit" value="{{refund}}" data-field="refund" bindinput="input"/></view><view class="field"><text class="field-label">审核说明（拒绝时必填）</text><textarea value="{{response}}" data-field="response" bindinput="input" maxlength="200"/></view><view class="info">线下收取的尾款如需退款，请线下处理；模拟线上退款需在审核后单独执行。</view><button disabled="{{busy}}" loading="{{busy}}" bindtap="submitReview">保存审核结果</button></block></scroll-view></view>
