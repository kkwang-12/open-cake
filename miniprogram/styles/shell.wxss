view, text, input, textarea, button { box-sizing: border-box; }
button { margin: 0; padding: 0; color: inherit; font: inherit; line-height: inherit; background: transparent; }
button::after { border: 0; }
.page { padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); }
.eyebrow { display: block; color: var(--color-body); font-size: 22rpx; letter-spacing: 2rpx; }
.title { font-size: 32rpx; font-weight: 650; line-height: 1.4; margin: 16rpx 0; }
.display-title { font-size: 32rpx; font-weight: 700; line-height: 1.4; margin: 24rpx 0; }
.subtitle, .muted { color: var(--color-body); font-size: 24rpx; }
.section { margin-top: 48rpx; }
.section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 16rpx; margin-bottom: 24rpx; }
.section-title { font-size: 32rpx; font-weight: 600; }
.primary-action, .secondary-action { min-height: 44px; padding: 24rpx 32rpx; font-size: 28rpx; border-radius: 999rpx; text-align: center; }
.primary-action.primary-action { display: block; width: 100% !important; color: #FFFFFF; background: #111111; }
.secondary-action { color: #111111; border: 1rpx solid #D5D2CD; }
.primary-action[disabled], .secondary-action[disabled] { opacity: .4; }
.primary-action[disabled] { color: #FFFFFF !important; background: #111111 !important; }
.action-row { display: flex; gap: 16rpx; flex-wrap: wrap; margin-top: 32rpx; }
.action-row button { flex: 1; width: auto !important; min-width: 240rpx; }
.status-note { padding: 24rpx 0; border-bottom: 1rpx solid var(--color-line); color: var(--color-body); font-size: 22rpx; }
.error-note { padding: 24rpx; margin: 24rpx 0; border: 1rpx solid var(--color-line); border-radius: 24rpx; font-size: 24rpx; overflow-wrap: break-word; }
.error-reference { display: block; margin-top: 8rpx; color: var(--color-body); font-size: 22rpx; }
.product-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32rpx 24rpx; }
.pressed { opacity: .65; }
.list-row { width: 100% !important; min-height: 56px; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--color-line); text-align: left; }
.list-row text { overflow-wrap: break-word; }
.footnote { display: block; margin-top: 48rpx; font-size: 22rpx; color: var(--color-body); }
