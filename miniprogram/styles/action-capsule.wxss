.action-safe-footer { padding: 14px var(--tab-bar-inset, 24px) calc(var(--tab-bar-bottom-gap, 7px) + env(safe-area-inset-bottom)); background: var(--color-bg); }
.action-capsule { display: flex; align-items: center; justify-content: center; width: 100% !important; height: var(--tab-bar-height, 58px); margin: 0 !important; padding: 0; border: 0; border-radius: 29px; background: #111111; box-shadow: none; color: #fff; font-size: 18px; font-weight: 500; line-height: 1.6; }
.action-capsule::after { border: 0; }
