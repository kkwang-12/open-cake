.action-safe-footer { padding: 14px 5.5vw calc(18px + env(safe-area-inset-bottom)); background: var(--color-bg); }
.action-capsule { display: flex; align-items: center; justify-content: center; width: 100% !important; height: 58px; margin: 0 !important; padding: 0; border-radius: 32px; background: #111; color: #fff; font-size: 20px; font-weight: 500; line-height: 1.6; }
.action-capsule::after { border: 0; }
