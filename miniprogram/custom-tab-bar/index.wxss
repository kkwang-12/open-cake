.tab-bar { position: fixed; left: 16px; right: 16px; bottom: 12px; bottom: calc(12px + env(safe-area-inset-bottom)); z-index: 20; display: flex; align-items: center; height: 66px; padding: 0 4px; border-radius: 33px; background: #111111; box-shadow: 0 2px 8px rgba(0,0,0,.04); box-sizing: border-box; }
.tab-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; width: auto !important; min-width: 0; min-height: 68px; height: 68px; margin: 0 !important; padding: 0; border: 0; border-radius: 34px; color: rgba(255,255,255,.68); background: transparent; line-height: 1; }
.tab-item::after { border: 0; }
.tab-icon { display: block; width: 24px; height: 24px; flex-shrink: 0; opacity: .68; }
.selected .tab-icon { opacity: 1; }
.tab-label { font-size: 12px; line-height: 16px; font-weight: 500; }
.tab-item.selected { color: #FFFFFF; }
