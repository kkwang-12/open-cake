.tab-bar { position: fixed; left: var(--tab-bar-inset, 24px); right: var(--tab-bar-inset, 24px); bottom: 7px; bottom: calc(var(--tab-bar-bottom-gap, 7px) + env(safe-area-inset-bottom)); z-index: 20; display: flex; align-items: center; height: var(--tab-bar-height, 58px); padding: 0; border: 0; border-radius: 29px; background: #111111; box-shadow: none; box-sizing: border-box; }
.tab-item { flex: 1 1 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; width: auto !important; min-width: 0; min-height: var(--tab-bar-height, 58px); height: var(--tab-bar-height, 58px); margin: 0 !important; padding: 0; border: 0; border-radius: 29px; color: rgba(255,255,255,.68); background: transparent; line-height: 1; }
.tab-item::after { border: 0; }
.tab-icon { display: block; width: 21px; height: 21px; flex-shrink: 0; opacity: .68; }
.selected .tab-icon { opacity: 1; }
.tab-label { font-size: 12px; line-height: 16px; font-weight: 400; }
.selected .tab-label { font-weight: 500; }
.tab-item.selected { color: #FFFFFF; }
