page{background:#FAFAF8;color:#4e3a2d;font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx}view,text,input,textarea,button{box-sizing:border-box}button{border-radius:20rpx;font-size:26rpx;line-height:1.5;padding:24rpx 30rpx;background:#b5684c;color:#fff;margin:0}button::after{border:0}button[disabled]{opacity:.5;color:#fff;background:#b5684c}.page{padding:32rpx 32rpx 60rpx}.demo{background:#efe6da;color:#927b64;font-size:20rpx;text-align:center;padding:13rpx 12rpx;line-height:1.7}.title{font-size:44rpx;font-weight:600;line-height:1.5;margin:16rpx 0}.subtitle{color:#978473;font-size:24rpx;line-height:1.8;margin-bottom:30rpx}.section-title{font-size:32rpx;font-weight:600;margin-bottom:24rpx}.muted{color:#978473}.small{font-size:22rpx;line-height:1.8}.panel{background:#fffdf9;border:1rpx solid #eae0d4;border-radius:30rpx;padding:30rpx;margin-bottom:28rpx}.info{padding:24rpx;background:#f4efe5;border-radius:18rpx;color:#958064;font-size:23rpx;line-height:1.8;margin:22rpx 0}.error{padding:24rpx;background:#f9e6df;border-radius:18rpx;color:#a34f42;font-size:24rpx;line-height:1.8;margin:20rpx 0}.row{display:flex;justify-content:space-between;align-items:center;gap:20rpx;margin-bottom:22rpx}.data-row{display:flex;gap:24rpx;font-size:25rpx;line-height:1.8;margin-bottom:18rpx;word-break:break-all}.data-row .label{width:140rpx;flex-shrink:0;color:#978473}.price{color:#b5684c;font-size:38rpx;font-weight:600}.tag{color:#917a61;background:#eee5d8;padding:9rpx 18rpx;border-radius:40rpx;font-size:21rpx;display:inline-block}.status{background:#f4e6d8;color:#a77d56;border-radius:40rpx;padding:9rpx 18rpx;font-size:22rpx}.actions{display:flex;gap:18rpx;flex-wrap:wrap;margin-top:24rpx}.actions button{flex:1;min-width:200rpx}.light{background:#f4e2d7;color:#b5684c}.outline{background:transparent;color:#715b48;border:1rpx solid #eae0d4}.field{margin-bottom:28rpx}.field-label{font-size:25rpx;color:#715b48;margin-bottom:14rpx;display:block}input,textarea,.picker{border:1rpx solid #eae0d4;border-radius:18rpx;background:#fffdf9;padding:22rpx 24rpx;font-size:26rpx;width:100%;min-height:82rpx}textarea{height:160rpx;line-height:1.7}.choices{display:flex;gap:16rpx;flex-wrap:wrap}.choice{padding:17rpx 28rpx;border:1rpx solid #eae0d4;border-radius:18rpx;background:#fffdf9;font-size:25rpx;color:#978473}.choice.selected{color:#b5684c;background:#f6e5d8;border-color:#c78d71}.empty{text-align:center;border:1rpx dashed #eae0d4;border-radius:28rpx;padding:70rpx 30rpx;color:#978473;background:#fffdf9}.empty .title{color:#715b48;font-size:32rpx}.empty button{margin-top:26rpx}.thumb{width:140rpx;height:140rpx;background:#f2e3d5;border-radius:22rpx;overflow:hidden;flex-shrink:0;display:flex;align-items:center;justify-content:center}.thumb cake-art{transform:scale(.58)}.product-line{display:flex;gap:24rpx;align-items:center;margin:24rpx 0}.product-line .name{font-size:30rpx;font-weight:600;margin-bottom:12rpx}.divider{border-top:1rpx solid #eae0d4;padding-top:24rpx;margin-top:24rpx}.full{width:100%}.footnote{font-size:21rpx;color:#978473;line-height:1.9;text-align:center;padding:26rpx 0}.pair{display:flex;gap:22rpx}.pair .field{flex:1;min-width:0}.timeline{border-left:1rpx solid #eae0d4;padding-left:26rpx;margin-left:10rpx}.history{font-size:24rpx;line-height:1.8;padding-bottom:24rpx}.history .muted{display:block;font-size:20rpx}.back-link{color:#978473;font-size:24rpx;margin-bottom:28rpx}.notification{padding:20rpx 0;border-bottom:1rpx solid #eae0d4;font-size:24rpx;line-height:1.7}
