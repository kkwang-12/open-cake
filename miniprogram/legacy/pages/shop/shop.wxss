@import "../../styles/demo.wxss";
.hero{position:relative;overflow:hidden;border-radius:36rpx;background:#f1e7d8;padding:42rpx 34rpx;min-height:440rpx}.eyebrow{font-size:16rpx;letter-spacing:3rpx;color:#a77d5d;margin-bottom:20rpx}.hero-title{font-size:43rpx;font-weight:600;line-height:1.6;position:relative;z-index:1}.hero-text{font-size:22rpx;color:#a08770;line-height:1.8;max-width:365rpx;position:relative;z-index:1;margin:14rpx 0 24rpx}.hero-button{font-size:22rpx;width:255rpx;position:relative;z-index:1;margin:0;padding:20rpx}.hero-art{position:absolute;right:-60rpx;bottom:4rpx;transform:scale(.94)}.services{display:flex;justify-content:space-between;padding:35rpx 8rpx;margin-bottom:30rpx;border-bottom:1rpx solid #eae0d4;font-size:21rpx;color:#a08770}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24rpx}.card{background:#fffdf9;border:1rpx solid #eae0d4;border-radius:28rpx;overflow:hidden}.art{height:280rpx;position:relative;background:#f5e9de;display:flex;justify-content:center;align-items:center}.art cake-art{transform:scale(.85)}.cocoa .art{background:#eae2d8}.peach .art{background:#f8e9df}.badge{position:absolute;top:20rpx;left:18rpx;font-size:18rpx;color:#a47b60;background:#fffaf0cc;padding:9rpx 14rpx;border-radius:10rpx;z-index:1}.content{padding:25rpx 22rpx}.name{font-size:29rpx;font-weight:600;margin-bottom:8rpx}.content .small{font-size:19rpx}.price-row{display:flex;justify-content:space-between;align-items:center;margin-top:22rpx}.price{font-size:32rpx}.from{font-size:18rpx;color:#978473;margin-left:6rpx;font-weight:400}.plus{background:#f2e6dc;color:#b5684c;width:50rpx;height:50rpx;border-radius:50%;text-align:center;line-height:50rpx;font-size:34rpx}.section-title{margin-bottom:8rpx}
