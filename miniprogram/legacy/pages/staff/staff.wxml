<view class="demo">演示环境 · 管理操作仅向已登录店员开放</view><view class="page"><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{!authorized}}" class="panel"><view class="title">店员工作台</view><view class="subtitle">默认演示口令：246810，若已修改请使用新口令。正式版需要绑定微信身份，演示口令不能用于真实营业。</view><view class="field"><text class="field-label">店员演示口令</text><input password value="{{pin}}" data-field="pin" bindinput="input" maxlength="32"/></view><button disabled="{{busy}}" loading="{{busy}}" bindtap="login">登录工作台</button></view><block wx:else><view class="row"><view class="title">门店工作台</view><text class="small muted" bindtap="logout">退出店员</text></view><view class="tabs"><view class="choice {{tab === 'orders' ? 'selected' : ''}}" data-tab="orders" bindtap="tab">订单</view><view class="choice {{tab === 'products' ? 'selected' : ''}}" data-tab="products" bindtap="tab">商品</view><view class="choice {{tab === 'settings' ? 'selected' : ''}}" data-tab="settings" bindtap="tab">设置</view><view class="choice {{tab === 'notifications' ? 'selected' : ''}}" data-tab="notifications" bindtap="tab">消息 {{unread ? '(' + unread + ')' : ''}}</view></view><block wx:if="{{tab === 'orders'}}"><view class="metrics"><view class="metric"><text>待确认</text><view>{{metrics.confirm}}</view></view><view class="metric"><text>待付定金</text><view>{{metrics.deposit}}</view></view><view class="metric"><text>制作与交付</text><view>{{metrics.active}}</view></view><view class="metric"><text>售后待审核</text><view>{{metrics.requests}}</view></view></view><button class="outline refresh" bindtap="load">刷新订单</button><view wx:if="{{!orders.length}}" class="empty">客户提交预订后，订单会显示在这里。</view><view wx:for="{{orders}}" wx:key="id" class="panel" data-id="{{item.id}}" bindtap="open"><view class="row"><text class="small muted">{{item.number}}</text><text class="status">{{item.statusLabel}}</text></view><view class="product-line"><view class="thumb"><cake-art theme="{{item.product.theme}}"/></view><view><view class="name">{{item.product.name}}</view><view class="small muted">{{item.product.size}} / {{item.product.flavor}}</view><view class="small muted">{{item.date}} {{item.time}} · {{item.fulfillment === 'pickup' ? '自取' : '配送'}}</view><view class="small muted">{{item.contactName}} · {{item.phone}}</view></view></view><view wx:if="{{item.request}}" class="info">有取消或改期申请待审核</view><view class="row divider"><text class="small">总额 ¥{{item.totalYuan}} · 已付 ¥{{item.paidYuan}}</text><text class="small">处理 →</text></view></view></block><block wx:elif="{{tab === 'products'}}"><view class="info">修改价格仅影响新订单，已有订单保留原价格。</view><block wx:if="{{!editing}}"><view wx:for="{{products}}" wx:key="id" class="panel"><view class="row"><view class="section-title">{{item.name}}</view><text class="tag">{{item.onSale ? '在售' : '已下架'}}</text></view><view class="small muted" wx:for="{{item.sizes}}" wx:for-item="size" wx:key="name">{{size.name}} · ¥{{size.priceYuan}}</view><button class="outline edit-button" data-id="{{item.id}}" bindtap="edit">编辑商品与上下架</button></view></block><view wx:else class="panel"><view class="field"><text class="field-label">商品名称</text><input value="{{editing.name}}" data-field="name" bindinput="editInput" maxlength="40"/></view><view class="field"><text class="field-label">副标题</text><input value="{{editing.subtitle}}" data-field="subtitle" bindinput="editInput" maxlength="60"/></view><view class="field"><text class="field-label">商品描述</text><textarea value="{{editing.description}}" data-field="description" bindinput="editInput" maxlength="500"/></view><view class="field"><text class="field-label">规格与价格，每行“规格:元”</text><textarea value="{{sizeText}}" data-field="sizeText" bindinput="input" maxlength="2000"/></view><view class="field"><text class="field-label">口味，每行一种</text><textarea value="{{flavorText}}" data-field="flavorText" bindinput="input" maxlength="1000"/></view><view class="row"><text>上架销售</text><switch checked="{{editing.onSale}}" color="#b5684c" bindchange="onSale"/></view><view class="actions"><button class="outline" bindtap="closeEdit">返回</button><button disabled="{{busy}}" bindtap="saveProduct">保存商品</button></view></view></block><view wx:elif="{{tab === 'settings'}}" class="panel"><view class="section-title">门店设置</view><view class="pair"><view class="field"><text class="field-label">开始营业</text><picker mode="time" value="{{settings.openTime}}" data-field="openTime" bindchange="settingsTime"><view class="picker">{{settings.openTime}}</view></picker></view><view class="field"><text class="field-label">结束营业</text><picker mode="time" value="{{settings.closeTime}}" data-field="closeTime" bindchange="settingsTime"><view class="picker">{{settings.closeTime}}</view></picker></view></view><view class="field"><text class="field-label">门店地址（可留空）</text><input value="{{settings.address}}" data-field="address" bindinput="settingsInput" maxlength="200"/></view><view class="field"><text class="field-label">联系电话（可留空）</text><input value="{{settings.phone}}" data-field="phone" bindinput="settingsInput" maxlength="30"/></view><view class="field"><text class="field-label">售后规则</text><textarea value="{{settings.afterSalesPolicy}}" data-field="afterSalesPolicy" bindinput="settingsInput" maxlength="500"/></view><view class="info">定金30%，暂不收配送费；档期和配送范围由店员逐单确认。</view><button disabled="{{busy}}" bindtap="saveSettings">保存门店设置</button></view><view wx:else class="panel"><view class="section-title">消息提醒</view><view class="info">此处展示提醒效果，不发送真实手机消息。</view><view wx:if="{{!notifications.length}}" class="small muted">还没有提醒。</view><view wx:for="{{notifications}}" wx:key="id" class="notification" data-id="{{item.orderId}}" bindtap="open">{{item.title}} → 查看订单</view></view></block></view>
